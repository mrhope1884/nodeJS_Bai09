extends layouts/default.pug
include mixins/box-head.pug

block main

    +box-head("Trang giới thiệu sản phẩm ", "Đây là mô tả trang sản phẩm ")
       
    ul 
        .col 
            each item in products 
                li(class="card" style="width: 18rem; padding: 10px; margin-bottom: 20px; margin-left: 0;")
                    img(src=item.thumbnail, class="card-img-top" width="100"  )
                    div(class="list-group-item d-flex justify-content-between align-items-center" style="margin: 10px;") 
                        h5 #{item.title} 
                    a(class="badge text-bg-primary rounded-pill" class="btn btn-primary") #{item.price}
            